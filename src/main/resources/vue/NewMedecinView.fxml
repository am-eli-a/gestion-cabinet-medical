<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="20.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.univartois.butinfo.sae.cabinet.controleur.NewMedecinController">
    <children>
        <TextField fx:id="nom" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" promptText="Nom" />
        <TextField fx:id="prenom" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" promptText="Prenom" />
        <TextField fx:id="email" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" promptText="Email" />
        <TextField fx:id="telephone" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" promptText="Telephone" />
      <TextField fx:id="ordre" layoutX="30.0" layoutY="260.0" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" promptText="Numero d'ordre" />
      <TextField fx:id="tarif" layoutX="30.0" layoutY="168.0" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" promptText="Tarif Horaire" />
        <ComboBox fx:id="specialite" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" promptText="specialite" />
        <HBox alignment="CENTER" spacing="20.0">
            <children>
                <Button mnemonicParsing="false" onAction="#validate" text="OK" />
                <Button mnemonicParsing="false" onAction="#cancel" text="Annuler" />
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
