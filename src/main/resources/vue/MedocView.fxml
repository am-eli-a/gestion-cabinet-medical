<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="fr.univartois.butinfo.sae.cabinet.controleur.MedocController"
            prefWidth="720.0" prefHeight="440.0">

    <left>
        <ListView fx:id="medocListView" prefWidth="240.0">
            <BorderPane.margin>
                <Insets top="10.0" right="5.0" bottom="10.0" left="10.0"/>
            </BorderPane.margin>
        </ListView>
    </left>

    <center>
        <GridPane hgap="12.0" vgap="10.0">
            <padding>
                <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
            </padding>

            <Label text="Détails du médicament"
                   GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.columnSpan="2">
                <font>
                    <Font name="System Bold" size="16.0"/>
                </font>
            </Label>

            <Label text="Nom :"        GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="nomLabel"    GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Description :"      GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="descriptionLabel"  GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Prix :"      GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <Label fx:id="prixLabel"  GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        </GridPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="10" BorderPane.alignment="CENTER">
            <children>
                <Button mnemonicParsing="false" text="Ajouter" onAction="#ajouter"/>
                <Button mnemonicParsing="false" text="Supprimer" onAction="#supprimer"/>
                <Button mnemonicParsing="false" text="Menu" onAction="#onMenu" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
